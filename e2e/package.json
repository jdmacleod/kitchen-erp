{
  "name": "kitchen-erp-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Browser tests against the Compose stack.",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "install-browsers": "playwright install chromium",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../.prettierignore --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore --ignore-path .gitignore"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.6.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "packageManager": "pnpm@12.5.1"
}
