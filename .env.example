# Copy to .env and change the passwords. Every variable is documented here.

# Database passwords. The owner role runs migrations; the app role is what the
# api and worker connect as and holds no UPDATE/DELETE on append-only tables.
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app

# Host ports (all bound to localhost except the web UI).
DB_PORT=5433
API_PORT=8000
WEB_PORT=8080

# Language model server. On macOS run Ollama natively on the host and keep this
# default; on Linux with a GPU use `docker compose --profile llm up` and set
# OLLAMA_BASE_URL=http://ollama:11434. Any model that honours JSON-schema
# constrained output will do.
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=gpt-oss:20b

# Server-side OCR adapter used when a client supplies no text.
OCR_ADAPTER=tesseract

# Optional outbound integrations. Both off by default; when on, they are
# rate-limited, cached, and send only public place data.
ENABLE_OVERPASS=false
ENABLE_NOMINATIM=false

# Host path of the household's Cooklang recipe repository checkout, mounted
# read-only at /data/recipes and indexed from Phase 3. Defaults to the
# `cooklang-recipes` repository beside this one.
RECIPES_PATH=../cooklang-recipes

# Zone used to interpret times printed on receipts and to evaluate opening hours.
HOUSEHOLD_TIMEZONE=America/Los_Angeles

# The system is single-currency; this is a display label only.
CURRENCY=USD

# An ingest job locked longer than this is considered abandoned and re-claimable.
INGEST_LOCK_TIMEOUT_SECONDS=600

# Ingest pipeline (Phase 2C). OCR adapters in order of preference, as a JSON list.
# A stage that fails is retried with exponential backoff (base * factor^attempt)
# up to INGEST_MAX_ATTEMPTS, then marked failed. An unreachable model server never
# fails a job: it waits, with the backoff capped at INGEST_BACKOFF_MAX_SECONDS.
OCR_ADAPTERS=["client","tesseract"]
INGEST_MAX_ATTEMPTS=5
INGEST_BACKOFF_BASE_SECONDS=5
INGEST_BACKOFF_FACTOR=4
INGEST_BACKOFF_MAX_SECONDS=300
# A receipt is matched to a location by proximity within this many metres.
INGEST_LOCATION_RADIUS_M=300
# Extra attempts when model output fails schema validation, before the job goes
# to review with raw text.
LLM_MAX_RETRIES=2

# Set to true when the web UI is served over HTTPS.
COOKIE_SECURE=false

LOG_LEVEL=INFO
