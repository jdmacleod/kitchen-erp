# Mirrors .gitignore for the build context. Real data must never be baked into
# an image layer or sent to the daemon. Note the `**/` prefixes: a .dockerignore
# pattern without one matches only at the root, unlike .gitignore.
data/
data.bak-*/
backups/
output/
reference/
cookcli/
grocy/
kitchenowl/
mealie/
paprika-recipes/
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.dump
**/*.pgdump
**/*.backup
**/*.sql.gz
**/*.heic
**/*.heif
**/*.pdf
**/*.csv
**/*.tsv
**/*.xls
**/*.xlsx
**/*.ods
**/*.doc
**/*.docx
**/*.eml
**/*.mbox
**/*.zip
**/*.7z
**/*.rar
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.pmtiles
**/*.mbtiles
**/*.osm.pbf
tools/denylist.txt
.env
.env.*
**/*.local.*
**/*.pem
**/*.key
.gstack/
.git/
.github/
__pycache__/
**/*.py[cod]
.venv/
venv/
**/*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
htmlcov/
node_modules/
frontend/dist/
.vite/
.DS_Store
