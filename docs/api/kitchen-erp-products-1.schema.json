{
  "$id": "kitchen-erp-products/1",
  "answer": {
    "$defs": {
      "AnswerCandidate": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Confidence"
          },
          "field": {
            "maxLength": 40,
            "title": "Field",
            "type": "string"
          },
          "source": {
            "enum": [
              "manufacturer",
              "usda_branded",
              "page_data",
              "page_meta",
              "adapter",
              "model"
            ],
            "title": "Source",
            "type": "string"
          },
          "source_url": {
            "anyOf": [
              {
                "maxLength": 2048,
                "pattern": "^https?://",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Url"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "$ref": "#/$defs/PriceValue"
              },
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                      "type": "string"
                    }
                  ]
                },
                "type": "object"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "field",
          "value",
          "source"
        ],
        "title": "AnswerCandidate",
        "type": "object"
      },
      "AnswerPhoto": {
        "additionalProperties": false,
        "properties": {
          "attribution": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Attribution"
          },
          "data_base64": {
            "maxLength": 8000000,
            "title": "Data Base64",
            "type": "string"
          },
          "mask_base64": {
            "anyOf": [
              {
                "maxLength": 8000000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Mask Base64"
          },
          "role": {
            "default": "product",
            "enum": [
              "product",
              "label_front",
              "label_nutrition",
              "label_ingredients",
              "shelf_tag"
            ],
            "title": "Role",
            "type": "string"
          },
          "source_kind": {
            "enum": [
              "manufacturer",
              "open_food_facts",
              "vendor_listing"
            ],
            "title": "Source Kind",
            "type": "string"
          },
          "source_url": {
            "anyOf": [
              {
                "maxLength": 2048,
                "pattern": "^https?://",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Url"
          }
        },
        "required": [
          "data_base64",
          "source_kind"
        ],
        "title": "AnswerPhoto",
        "type": "object"
      },
      "PriceValue": {
        "additionalProperties": false,
        "description": "A price for a quantity: 0.69 for 1 lb. A bare number is a price for 1 each.",
        "properties": {
          "amount": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,13}0*$)\\d{0,8}\\.\\d{0,4}0*$)",
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "qty": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Qty"
          },
          "unit": {
            "maxLength": 16,
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "qty",
          "unit"
        ],
        "title": "PriceValue",
        "type": "object"
      }
