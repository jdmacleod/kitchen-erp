        },
        "maxItems": 100,
        "title": "Candidates",
        "type": "array"
      },
      "format": {
        "const": "kitchen-erp-products/1",
        "title": "Format",
        "type": "string"
      },
      "found": {
        "default": true,
        "title": "Found",
        "type": "boolean"
      },
      "photos": {
        "default": [],
        "items": {
          "$ref": "#/$defs/AnswerPhoto"
        },
        "maxItems": 4,
        "title": "Photos",
        "type": "array"
      },
      "reason": {
        "anyOf": [
          {
            "const": "unreachable",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Reason"
      },
      "request_id": {
        "format": "uuid",
        "title": "Request Id",
        "type": "string"
      }
    },
    "required": [
      "format",
      "request_id"
    ],
    "title": "HelperAnswer",
    "type": "object"
  },
  "listing_prices": {
